<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pacmen.scene.MainMenuController"
           stylesheets="@../css/arcade.css,@../css/main-menu.css"
           fx:id="rootPane"
           prefWidth="900" prefHeight="650">

    <Pane fx:id="bgPane" styleClass="bg-pane" maxWidth="Infinity" maxHeight="Infinity"/>

    <!-- Ghost decorations -->
    <Pane mouseTransparent="true">
        <Label fx:id="ghostBlinky" styleClass="ghost-deco" text="ᗣ" layoutX="60"  layoutY="80"/>
        <Label fx:id="ghostPinky"  styleClass="ghost-deco" text="ᗣ" layoutX="790" layoutY="100"/>
        <Label fx:id="ghostInky"   styleClass="ghost-deco" text="ᗣ" layoutX="40"  layoutY="500"/>
        <Label fx:id="ghostClyde"  styleClass="ghost-deco" text="ᗣ" layoutX="820" layoutY="480"/>
    </Pane>

    <VBox alignment="CENTER" spacing="0" styleClass="content-vbox">

        <VBox alignment="CENTER" styleClass="logo-section" spacing="6">
            <HBox fx:id="dotRowTop"    alignment="CENTER" spacing="14" styleClass="dot-row"/>
            <Label fx:id="titleLabel"  styleClass="title-label" text="PACMEN"/>
            <Label styleClass="subtitle-label" text="MULTIPLAYER MAZE MADNESS"/>
            <HBox fx:id="dotRowBottom" alignment="CENTER" spacing="14" styleClass="dot-row"/>
        </VBox>

        <Region prefHeight="36"/>

        <VBox fx:id="menuButtons" alignment="CENTER" spacing="16" styleClass="menu-vbox">
            <Button styleClass="menu-btn, btn-play"      text="▶  PLAY"         maxWidth="340" onAction="#onPlay"/>
            <Button styleClass="menu-btn, btn-cyan"      text="⬡  HOST GAME"    maxWidth="340" onAction="#onHostGame"/>
            <Button styleClass="menu-btn, btn-cyan"      text="⬡  JOIN GAME"    maxWidth="340" onAction="#onJoinGame"/>
            <Button styleClass="menu-btn, btn-pink"      text="⚙  SETTINGS"     maxWidth="340" onAction="#onSettings"/>
            <Button styleClass="menu-btn, btn-orange"    text="★  LEADERBOARD"  maxWidth="340" onAction="#onLeaderboard"/>
            <Button styleClass="menu-btn, btn-quit"      text="✕  QUIT"         maxWidth="340" onAction="#onQuit"/>
        </VBox>

        <Region prefHeight="24"/>

        <HBox alignment="CENTER" spacing="32" styleClass="footer-hbox">
            <Label styleClass="footer-label" text="© 2025 PACMEN DEVS"/>
            <Label style="-fx-font-size:10px;-fx-text-fill:rgba(255,215,0,0.3);" text="·"/>
            <Label fx:id="playerCountLabel" styleClass="footer-label" text="PLAYERS ONLINE: —"/>
            <Label style="-fx-font-size:10px;-fx-text-fill:rgba(255,215,0,0.3);" text="·"/>
            <Label styleClass="footer-label" text="v1.0.0"/>
        </HBox>
    </VBox>

    <!-- Splash overlay -->
    <StackPane fx:id="splashOverlay" styleClass="splash-overlay">
        <VBox alignment="CENTER" spacing="20">
            <Label styleClass="splash-title" text="PACMEN"/>
            <Label fx:id="insertCoinLabel" styleClass="insert-coin" text="INSERT COIN"/>
        </VBox>
    </StackPane>

</StackPane>