<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="650" prefWidth="900" stylesheets="@../css/arcade.css,@../css/main-menu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pacmen.scene.MainMenuController">

    <Pane fx:id="bgPane" maxHeight="Infinity" maxWidth="Infinity" styleClass="bg-pane" />

    <!-- Ghost decorations -->
    <Pane mouseTransparent="true">
        <Label fx:id="ghostBlinky" layoutX="60" layoutY="80" styleClass="ghost-deco" text="ᗣ" />
        <Label fx:id="ghostPinky" layoutX="790" layoutY="100" styleClass="ghost-deco" text="ᗣ" />
        <Label fx:id="ghostInky" layoutX="40" layoutY="500" styleClass="ghost-deco" text="ᗣ" />
        <Label fx:id="ghostClyde" layoutX="820" layoutY="480" styleClass="ghost-deco" text="ᗣ" />
    </Pane>

    <!-- Splash overlay -->
    <StackPane fx:id="splashOverlay" styleClass="splash-overlay" />

    <VBox alignment="CENTER" spacing="0" styleClass="content-vbox">

        <VBox alignment="CENTER" spacing="6" styleClass="logo-section">
            <HBox fx:id="dotRowTop" alignment="CENTER" spacing="14" styleClass="dot-row" />
            <Label fx:id="titleLabel" styleClass="title-label" text="PACMEN" />
            <Label styleClass="subtitle-label" text="MULTIPLAYER MAZE MADNESS" />
            <HBox fx:id="dotRowBottom" alignment="CENTER" spacing="14" styleClass="dot-row" />
        </VBox>

        <Region prefHeight="36" />

        <VBox fx:id="menuButtons" alignment="CENTER" spacing="16" styleClass="menu-vbox">
            <Button maxWidth="340" onAction="#onPlay" styleClass="menu-btn, btn-play" text="▶  SINGLEPLAYER" />
            <Button maxWidth="340" onAction="#onHostGame" styleClass="menu-btn, btn-play" text="▶  MULTIPLAYER" />
            <Button maxWidth="340" onAction="#onLeaderboard" styleClass="menu-btn" text="★  LEADERBOARD" />
            <Button maxWidth="340" onAction="#onQuit" styleClass="menu-btn, btn-quit" text="✕  QUIT" />
        </VBox>

        <Region prefHeight="24" />

        <HBox alignment="CENTER" spacing="32" styleClass="footer-hbox">
            <Label styleClass="footer-label" text="© 2025 PACMEN DEVS" />
            <Label style="-fx-font-size:10px;-fx-text-fill:rgba(255,215,0,0.3);" text="·" />
            <Label fx:id="playerCountLabel" styleClass="footer-label" text="PLAYERS ONLINE: —" />
            <Label style="-fx-font-size:10px;-fx-text-fill:rgba(255,215,0,0.3);" text="·" />
            <Label styleClass="footer-label" text="v1.0.0" />
        </HBox>
    </VBox>

</StackPane>
